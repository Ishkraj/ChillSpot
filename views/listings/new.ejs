<% layout("layouts/boilerplate") %>
<body>
  <div class="row">
    <div class="col-8 offset-2">
      <br />
      <h3>Create New Listing</h3>

      <form
        method="POST"
        action="/listings"
        class="needs-validation"
        novalidate
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            name="listing[title]"
            type="text"
            placeholder="Add a catchy title"
            class="form-control"
            required
          />
          <div class="valid-feedback">Title looks good</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            name="listing[description]"
            placeholder="Enter description"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">Description should be valid</div>
        </div>

        <div class="mb-3">
          <label for="imageUpload" class="form-label">Upload Images</label>
          <input
            id="imageUpload"
            name="listing[images]"
            type="file"
            class="form-control"
            multiple
            accept="image/*"
          />
          <div id="previewContainer" class="mt-3 d-flex flex-wrap gap-3"></div>
        </div>

        <div class="mb-3">
          <label for="pricingType" class="form-label">What kind of stay is this?</label>
          <select name="listing[pricingType]" id="pricingType" class="form-select" required>
            <option value="Daily" selected>Short-term / Daily Stays (Hotel style)</option>
            <option value="Monthly">Long-term / Monthly Rent (PG/Flat style)</option>
            <option value="Both">Both (Daily & Monthly Options)</option>
          </select>
        </div>

        <div class="row">
          <div class="mb-3 col-md-6" id="dailyPriceDiv">
            <label for="price" class="form-label">Daily Price (₹ / night)</label>
            <input
              name="listing[price]"
              type="number"
              id="dailyPriceInput"
              placeholder="1200"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Daily price is required</div>
          </div>

          <div class="mb-3 col-md-6" id="monthlyPriceDiv" style="display: none;">
            <label for="monthlyPrice" class="form-label">Monthly Rent (₹ / month)</label>
            <input
              name="listing[monthlyPrice]"
              type="number"
              id="monthlyPriceInput"
              placeholder="15000"
              class="form-control"
            />
            <div class="invalid-feedback">Monthly rent is required</div>
          </div>
        </div>

        <div class="card mb-4 mt-2 border-0 bg-light">
          <div class="card-body">
            <div class="form-check form-switch fs-5">
              <input 
                class="form-check-input" 
                type="checkbox" 
                role="switch" 
                id="instantBookToggle" 
                name="listing[isInstantBook]" 
                value="true"
              >
              <label class="form-check-label ms-2" for="instantBookToggle">
                <b>⚡ Enable Instant Book</b>
              </label>
            </div>
            <p class="text-muted mt-2 mb-0" style="font-size: 0.9rem;">
              If enabled, guests won't need your manual approval to confirm their stay. Booking will be auto-accepted upon request.
            </p>
          </div>
        </div>
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            name="listing[location]"
            type="text"
            placeholder="Jaipur, Rajasthan"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Location should be valid</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Google Maps Exact Location Link</label>
          <input
            type="url"
            name="listing[mapLink]"
            class="form-control"
            placeholder="Paste Google Maps link here"
            required
          />
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select
            name="listing[category]"
            class="form-select"
            required
          >
            <option selected disabled>Select a category</option>
            <option value="Trending">Trending</option>
            <option value="Room">Room</option>
            <option value="Iconic Cities">Iconic Cities</option>
            <option value="Mountain">Mountain</option>
            <option value="Castles">Castles</option>
            <option value="Amazing Pools">Amazing Pools</option>
            <option value="Camping">Camping</option>
            <option value="Farm">Farm</option>
            <option value="Lakes">Lakes</option>
          </select>
          <div class="invalid-feedback">Please choose a category</div>
        </div>

        <div class="mb-3">
          <label for="country" class="form-label">Country</label>
          <input
            name="listing[country]"
            type="text"
            placeholder="Enter the country"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Country should be valid</div>
        </div>

        <button class="btn btn-dark add-btn">ADD</button>
        <br /><br />
      </form>
    </div>
  </div>

  <script>
    // 1. DYNAMIC PRICING LOGIC
    const pricingType = document.getElementById("pricingType");
    const dailyPriceDiv = document.getElementById("dailyPriceDiv");
    const monthlyPriceDiv = document.getElementById("monthlyPriceDiv");
    const dailyPriceInput = document.getElementById("dailyPriceInput");
    const monthlyPriceInput = document.getElementById("monthlyPriceInput");

    pricingType.addEventListener("change", function() {
      if (this.value === "Daily") {
        dailyPriceDiv.style.display = "block";
        dailyPriceInput.required = true;
        
        monthlyPriceDiv.style.display = "none";
        monthlyPriceInput.required = false;
        monthlyPriceInput.value = ""; // Hide & clear monthly
      } 
      else if (this.value === "Monthly") {
        dailyPriceDiv.style.display = "none";
        dailyPriceInput.required = false;
        dailyPriceInput.value = ""; // Hide & clear daily
        
        monthlyPriceDiv.style.display = "block";
        monthlyPriceInput.required = true;
      } 
      else if (this.value === "Both") {
        dailyPriceDiv.style.display = "block";
        dailyPriceInput.required = true;
        
        monthlyPriceDiv.style.display = "block";
        monthlyPriceInput.required = true;
      }
    });

    // 2. IMAGE UPLOAD PREVIEW LOGIC
    const imageInput = document.getElementById("imageUpload");
    const previewContainer = document.getElementById("previewContainer");
    let selectedFiles = [];

    imageInput.addEventListener("change", (event) => {
      const newFiles = Array.from(event.target.files);
      selectedFiles = [...selectedFiles, ...newFiles];
      renderPreviews();
    });

    function renderPreviews() {
      previewContainer.innerHTML = "";

      selectedFiles.forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = function (e) {
          const div = document.createElement("div");
          div.classList.add("position-relative");

          div.innerHTML = `
            <img src="${e.target.result}" style="width: 150px; height: 150px; object-fit: cover; border-radius: 5px;" />
            <button type="button" class="btn-close position-absolute top-0 end-0" aria-label="Remove" data-index="${index}" style="background-color: white;"></button>
          `;

          previewContainer.appendChild(div);

          div.querySelector("button").addEventListener("click", () => {
            selectedFiles.splice(index, 1);
            renderPreviews();
          });
        };
        reader.readAsDataURL(file);
      });

      const dataTransfer = new DataTransfer();
      selectedFiles.forEach(file => dataTransfer.items.add(file));
      imageInput.files = dataTransfer.files;
    }
  </script>
</body>