<% layout("/layouts/boilerplate") %>
<style>
    /* ===========================
   OTP PAGE WRAPPER
=========================== */

.otp-wrapper {
    min-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #f7f8fc;
    padding: 20px;
    font-family: "Inter", sans-serif;
  }
  
  
  /* ===========================
     OTP CARD
  =========================== */
  
  .otp-card {
    width: 100%;
    max-width: 420px;
    background: #ffffff;
    border-radius: 14px;
    padding: 35px 30px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.1);
    text-align: center;
    transition: all 0.3s ease;
  }
  
  
  /* ===========================
     HEADING
  =========================== */
  
  .otp-card h2 {
    font-weight: 700;
    margin-bottom: 10px;
    color: #111;
  }
  
  .otp-card p {
    font-size: 14px;
    color: #666;
    margin-bottom: 25px;
  }
  
  
  /* ===========================
     OTP INPUT
  =========================== */
  
  .otp-input {
    width: 100%;
    padding: 12px 15px;
    border-radius: 8px;
    border: 1px solid #ccc;
    font-size: 18px;
    text-align: center;
    letter-spacing: 6px;
    outline: none;
    margin-bottom: 20px;
    transition: 0.2s;
  }
  
  .otp-input:focus {
    border-color: #ff3d3d;
    box-shadow: 0 0 0 2px rgba(255, 61, 61, 0.2);
  }
  
  
  /* ===========================
     VERIFY BUTTON
  =========================== */
  
  .otp-btn {
    width: 100%;
    padding: 12px;
    border-radius: 30px;
    border: none;
    background: linear-gradient(135deg, #ff3d3d, #ff6b6b);
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: 0.3s;
  }
  
  .otp-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 61, 61, 0.4);
  }
  
  
  /* ===========================
     RESEND LINK
  =========================== */
  
  .resend-text {
    margin-top: 18px;
    font-size: 14px;
    color: #666;
  }
  
  .resend-text a {
    color: #ff3d3d;
    text-decoration: none;
    font-weight: 500;
  }
  
  .resend-text a:hover {
    text-decoration: underline;
  }
  
  
  /* ===========================
     DARK MODE
  =========================== */
  
  body.dark-mode .otp-wrapper {
    background: #0f1117;
  }
  
  body.dark-mode .otp-card {
    background: #161a23;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
  }
  
  body.dark-mode .otp-card h2 {
    color: #ffffff;
  }
  
  body.dark-mode .otp-card p {
    color: #b3b3b3;
  }
  
  body.dark-mode .otp-input {
    background: #1f2430;
    border-color: #333;
    color: #ffffff;
  }
  
  body.dark-mode .otp-input::placeholder {
    color: #777;
  }
  
  body.dark-mode .otp-input:focus {
    border-color: #ff3d3d;
  }
  
  body.dark-mode .resend-text {
    color: #aaa;
  }
  
  
  /* ===========================
     MOBILE RESPONSIVE
  =========================== */
  
  @media (max-width: 480px) {
    .otp-card {
      padding: 28px 22px;
    }
  
    .otp-input {
      font-size: 16px;
      letter-spacing: 4px;
    }
  }
  
</style>

<div class="otp-wrapper">

  <div class="otp-card">

    <h2>Verify OTP </h2>

    <p>
      We have sent a verification code to your email.
    </p>

    <form action="/verify-otp" method="POST">

      <input
        type="text"
        name="otp"
        maxlength="6"
        class="otp-input"
        placeholder="------"
        required
      />

      <button type="submit" class="otp-btn">
        Verify OTP
      </button>

    </form>

    <div class="resend-text">
      Didn't receive code?
      <a href="/signup">Resend</a>
    </div>

  </div>

</div>
