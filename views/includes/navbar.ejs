<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Responsive Navbar</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">

</head>
<body>

  <nav class="navbar navbar-expand-md navbar-custom sticky-top">
    <div class="container-fluid">
  
      <!-- LEFT : LOGO + SEARCH -->
      <div class="d-flex align-items-center gap-3">
  
        <!-- LOGO -->
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/listings">
          <i class="fa-solid fa-location-dot chill-icon"></i>
          <span class="brand-name">ChillSpot</span>
        </a>
  
        <!-- SEARCH -->
        <div class="mobile-search-wrapper">
          <form
            action="/listings/search"
            method="GET"
            class="nav-search"
            onsubmit="return validateSearch('desktopSearchInput')"
          >
            <i class="fa-solid fa-magnifying-glass"></i>
            <input
              type="text"
              name="q"
              id="desktopSearchInput"
              placeholder="Search your hotel, place, city..."
              autocomplete="off"
            />
          </form>
        </div>
      </div>
  
      <!-- ================= MOBILE MENU ================= -->
      <div class="ms-auto d-md-none position-relative">
  
        <button
          class="btn btn-outline-secondary"
          id="mobileMenuBtn"
          type="button"
        >
          <i class="fa-solid fa-bars"></i>
        </button>
  
        <ul id="mobileMenu" class="custom-dropdown">
  
          <% if (currUser) { %>
            <li><a href="/profile">👤 My Profile</a></li>
            <li><a href="/bookings">📦 My Bookings</a></li>
          <% } %>
  
          <li><a href="/listings">Chill Places</a></li>
          <li><a href="/listings/new">Host Your Stay</a></li>
  
          <% if (currUser && currUser.isHost) { %>
            <li>
              <a href="/listings/<%= currUser._id %>/bookings/host">
                🏠 Host Dashboard
              </a>
            </li>
          <% } %>
  
          <li>
            <button
              id="mobileThemeToggle"
              class="dropdown-item d-flex align-items-center gap-2"
              type="button"
            >
              🌙 Toggle Theme
            </button>
          </li>
  
          <% if (!currUser) { %>
            <li><a href="/signup">Sign Up</a></li>
            <li><a href="/login">Log In</a></li>
          <% } else { %>
            <li><a href="/logout" class="text-danger">Logout</a></li>
          <% } %>
        </ul>
      </div>
  
      <!-- ================= DESKTOP NAV ================= -->
      <div class="collapse navbar-collapse d-none d-md-flex">
        <ul class="navbar-nav ms-auto align-items-center gap-3">
  
          <li class="nav-item">
            <a class="nav-link" href="/listings">Chill Places</a>
          </li>
  
          <li class="nav-item">
            <a class="nav-link" href="/listings/new">Host Your Stay</a>
          </li>
  
          <button id="themeToggle" class="btn btn-sm">
            🌙
          </button>
  
          <% if (!currUser) { %>
            <li class="nav-item">
              <a class="nav-link fw-bold" href="/signup">Sign Up</a>
            </li>
            <li class="nav-item">
              <a class="nav-link fw-bold" href="/login">Log In</a>
            </li>
          <% } else { %>
          
            <!-- ===== MANUAL PROFILE DROPDOWN ===== -->
            <li class="nav-item position-relative">
          
              <!-- PROFILE ICON -->
              <button
                id="profileBtn"
                class="btn btn-light rounded-circle"
                type="button"
              >
                👤
              </button>
          
              <!-- DROPDOWN -->
              <div id="profileMenu" class="profile-dropdown">
                <a href="/profile">My Profile</a>
                <a href="/bookings">My Bookings</a>
          
                <% if (currUser.isHost) { %>
                  <a href="/bookings/host">Host Dashboard</a>
                <% } %>
          
                <hr />
                <a href="/logout" class="text-danger">Logout</a>
              </div>
          
            </li>
          
          <% } %>
          
          
        </ul>
      </div>
  
    </div>
  </nav>
  
  <!-- SEARCH VALIDATION -->
  <script>
    function validateSearch(id) {
      const input = document.getElementById(id);
      input.value = input.value.trim();
      if (input.value === "") {
        input.focus();
        return false;
      }
      return true;
    }
  </script>
  

  


</body>
</html>
